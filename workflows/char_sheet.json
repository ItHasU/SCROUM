{
  "_scroum": {
    "description": "Planche de référence d'un personnage (texte vers image).",
    "requires": [
      "unet",
      "clip",
      "vae"
    ],
    "defaults": {
      "steps": 20,
      "cfg": 2.5,
      "sampler": "euler",
      "scheduler": "simple",
      "shift": 3.1,
      "clip_type": "qwen_image"
    },
    "references": 0
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "{{clip_type}}",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{vae}}"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{prompt}}, character design reference sheet, front view, side view and back view, full body, neutral pose, plain light background"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{negative}}"
    }
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": "{{shift}}"
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "7",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": 1
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "filename_prefix": "scroum/char_sheet"
    }
  }
}
