{
  "_scroum": {
    "description": "Même cadrage et même pose que la référence, sujet transformé selon l'instruction (Qwen Image Edit).",
    "requires": [
      "unet",
      "clip",
      "vae"
    ],
    "defaults": {
      "steps": 20,
      "cfg": 2.5,
      "sampler": "euler",
      "scheduler": "simple",
      "shift": 3.1,
      "clip_type": "qwen_image"
    },
    "references": 1
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "{{clip_type}}",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{vae}}"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{ref_image_1}}"
    }
  },
  "5": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "4",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0
    }
  },
  "6": {
    "class_type": "TextEncodeQwenImageEdit",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "prompt": "Keep exactly the same framing, camera angle, composition and pose as the reference image. Change only the following: {{prompt}}",
      "vae": [
        "3",
        0
      ],
      "image": [
        "5",
        0
      ]
    }
  },
  "7": {
    "class_type": "TextEncodeQwenImageEdit",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "prompt": "{{negative}}",
      "vae": [
        "3",
        0
      ],
      "image": [
        "5",
        0
      ]
    }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "9": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": "{{shift}}"
    }
  },
  "10": {
    "class_type": "CFGNorm",
    "inputs": {
      "model": [
        "9",
        0
      ],
      "strength": 1.0
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "10",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "latent_image": [
        "8",
        0
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": 1
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "scroum/transform"
    }
  }
}
